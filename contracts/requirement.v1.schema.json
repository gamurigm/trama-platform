{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "requirement_id": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Requirement Id",
      "type": "string"
    },
    "organization_id": {
      "default": "default",
      "maxLength": 100,
      "minLength": 1,
      "title": "Organization Id",
      "type": "string"
    },
    "project_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "title": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "description": {
      "maxLength": 10000,
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "kind": {
      "default": "feature",
      "enum": [
        "feature",
        "change",
        "module",
        "refactor",
        "bugfix"
      ],
      "title": "Kind",
      "type": "string"
    },
    "acceptance_criteria": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Acceptance Criteria",
      "type": "array"
    },
    "status": {
      "default": "proposed",
      "enum": [
        "proposed",
        "approved",
        "in_progress",
        "completed",
        "blocked"
      ],
      "title": "Status",
      "type": "string"
    },
    "correlation_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "requirement_id",
    "project_id",
    "title",
    "description",
    "acceptance_criteria"
  ],
  "title": "Requirement",
  "type": "object"
}
