{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "uri": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "media_type": {
          "default": "application/octet-stream",
          "maxLength": 200,
          "title": "Media Type",
          "type": "string"
        },
        "sensitivity": {
          "default": "internal",
          "enum": [
            "public",
            "internal",
            "restricted",
            "secret"
          ],
          "title": "Sensitivity",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "uri",
        "sha256"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "Verification": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Command",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "default": "",
          "maxLength": 2000,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "command",
        "status"
      ],
      "title": "Verification",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "succeeded",
        "partial",
        "failed",
        "blocked"
      ],
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "files_changed": {
      "items": {
        "type": "string"
      },
      "maxItems": 1000,
      "title": "Files Changed",
      "type": "array"
    },
    "commands": {
      "items": {
        "type": "string"
      },
      "maxItems": 500,
      "title": "Commands",
      "type": "array"
    },
    "tests": {
      "items": {
        "$ref": "#/$defs/Verification"
      },
      "maxItems": 500,
      "title": "Tests",
      "type": "array"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "maxItems": 500,
      "title": "Artifacts",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "maxItems": 200,
      "title": "Warnings",
      "type": "array"
    },
    "knowledge_candidates": {
      "items": {
        "type": "string"
      },
      "maxItems": 200,
      "title": "Knowledge Candidates",
      "type": "array"
    }
  },
  "required": [
    "task_id",
    "status",
    "summary"
  ],
  "title": "AgentResult",
  "type": "object"
}
