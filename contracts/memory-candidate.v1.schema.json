{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "locator": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "commit_sha": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit Sha"
        },
        "detail": {
          "default": "",
          "maxLength": 4000,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "source",
        "locator"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "candidate_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Candidate Id",
      "type": "string"
    },
    "organization_id": {
      "default": "default",
      "maxLength": 100,
      "minLength": 1,
      "title": "Organization Id",
      "type": "string"
    },
    "project_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "agent_id": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent Id"
    },
    "task_id": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Id"
    },
    "source": {
      "default": "trama",
      "maxLength": 500,
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "subject": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Subject",
      "type": "string"
    },
    "fact": {
      "maxLength": 10000,
      "minLength": 1,
      "title": "Fact",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "visibility": {
      "default": "project",
      "enum": [
        "private",
        "project",
        "shared"
      ],
      "title": "Visibility",
      "type": "string"
    },
    "sensitivity": {
      "default": "internal",
      "enum": [
        "public",
        "internal",
        "restricted",
        "secret"
      ],
      "title": "Sensitivity",
      "type": "string"
    },
    "status": {
      "default": "candidate",
      "enum": [
        "candidate",
        "validated",
        "rejected"
      ],
      "title": "Status",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "candidate_id",
    "project_id",
    "subject",
    "fact",
    "evidence",
    "confidence"
  ],
  "title": "MemoryCandidate",
  "type": "object"
}
