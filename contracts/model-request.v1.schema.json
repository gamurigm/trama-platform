{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "request_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "project_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "agent_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Agent Id",
      "type": "string"
    },
    "model_profile": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Model Profile",
      "type": "string"
    },
    "purpose": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Purpose",
      "type": "string"
    },
    "input_reference": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Input Reference",
      "type": "string"
    },
    "max_cost_units": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Cost Units"
    },
    "max_seconds": {
      "anyOf": [
        {
          "maximum": 86400,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Seconds"
    },
    "sensitivity": {
      "default": "internal",
      "enum": [
        "public",
        "internal",
        "restricted",
        "secret"
      ],
      "title": "Sensitivity",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "project_id",
    "agent_id",
    "model_profile",
    "purpose",
    "input_reference"
  ],
  "title": "ModelRequest",
  "type": "object"
}
