{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
      "title": "Task Id",
      "type": "string"
    },
    "parent_task_id": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Task Id"
    },
    "requirement_id": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requirement Id"
    },
    "phase_id": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Phase Id"
    },
    "source": {
      "default": "manual",
      "enum": [
        "manual",
        "requirement"
      ],
      "title": "Source",
      "type": "string"
    },
    "correlation_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "depends_on": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "title": "Depends On",
      "type": "array"
    },
    "approved_by": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approved By"
    },
    "organization_id": {
      "default": "default",
      "maxLength": 100,
      "minLength": 1,
      "title": "Organization Id",
      "type": "string"
    },
    "project_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "objective": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Objective",
      "type": "string"
    },
    "actor": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Actor",
      "type": "string"
    },
    "repository": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Repository",
      "type": "string"
    },
    "branch": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Branch",
      "type": "string"
    },
    "worktree": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Worktree",
      "type": "string"
    },
    "allowed_paths": {
      "items": {
        "type": "string"
      },
      "maxItems": 500,
      "title": "Allowed Paths",
      "type": "array"
    },
    "read_only": {
      "default": false,
      "title": "Read Only",
      "type": "boolean"
    },
    "state": {
      "default": "accepted",
      "enum": [
        "planned",
        "accepted",
        "running",
        "succeeded",
        "partial",
        "failed",
        "blocked",
        "cancelled"
      ],
      "title": "State",
      "type": "string"
    },
    "execution_attempt": {
      "anyOf": [
        {
          "maximum": 1000000000,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Execution Attempt"
    },
    "acceptance_criteria": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Acceptance Criteria",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "project_id",
    "objective",
    "actor",
    "repository",
    "branch",
    "worktree",
    "acceptance_criteria"
  ],
  "title": "TaskEnvelope",
  "type": "object"
}
