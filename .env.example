TRAMA_ENV=local
TRAMA_ORGANIZATION_ID=default
TRAMA_STATE_DIR=artifacts/state
TRAMA_API_HOST=127.0.0.1
TRAMA_API_PORT=8090
TRAMA_API_URL=http://127.0.0.1:8090
TRAMA_API_TOKEN=
# Gateway Go distribuido; no guardar secretos en este archivo.
TRAMA_GATEWAY_URL=
TRAMA_GATEWAY_TOKEN=
TRAMA_GATEWAY_ADDR=:8080
TRAMA_DATABASE_URL=
TRAMA_DATABASE_MAX_OPEN_CONNS=64
TRAMA_DATABASE_MAX_IDLE_CONNS=16
TRAMA_NATS_URL=nats://127.0.0.1:4222
TRAMA_NATS_STREAM=TRAMA_EVENTS
TRAMA_NATS_SUBJECT=trama.task.admitted.v1
TRAMA_NATS_DURABLE=trama-python-dispatch
TRAMA_REDIS_URL=redis://127.0.0.1:6379/0
# Solo el gateway Go: dejar vacío en local sin autenticación.
TRAMA_GATEWAY_AUTH_REQUIRED=false
TRAMA_GATEWAY_OIDC_ISSUER=
TRAMA_GATEWAY_OIDC_AUDIENCE=
TRAMA_GATEWAY_SERVICE_ACCOUNT_TOKEN=
TRAMA_GATEWAY_SERVICE_ACCOUNT_ID=
TRAMA_GATEWAY_SERVICE_ACCOUNT_ORGANIZATION=
TRAMA_GATEWAY_SERVICE_ACCOUNT_SCOPES=tasks:write
TRAMA_GATEWAY_RATE_LIMIT=2000
TRAMA_GATEWAY_RATE_WINDOW_MS=1000
TRAMA_COORDINATION_BACKEND=memory
TRAMA_CCCC_EXECUTABLE=cccc
TRAMA_CCCC_TIMEOUT_SECONDS=30
TRAMA_QUEUE_CAPACITY=100
TRAMA_MAX_CONCURRENCY=4
TRAMA_DISPATCH_TIMEOUT_SECONDS=900
# Opcional: define esta ruta para activar Semantica nativa persistente.
TRAMA_SEMANTICA_KG_PATH=
# Utopia se activa solo cuando las tres variables están definidas.
TRAMA_UTOPIA_URL=
TRAMA_UTOPIA_KB_ID=
TRAMA_UTOPIA_TOKEN=
TRAMA_HERMES_EXECUTABLE=hermes
TRAMA_HERMES_CONFIG_PATH=~/.hermes/config.yaml
# Proveedor de inferencia local para Hermes y agentes locales Python.
TRAMA_OLLAMA_URL=http://127.0.0.1:11434
TRAMA_OLLAMA_MODEL=qwen3:8b
TRAMA_COLIBRI_URL=http://127.0.0.1:8020
TRAMA_COLIBRI_MODEL=OLMoE-1B-7B-0125-Instruct
TRAMA_COLIBRI_EXECUTABLE=coli
TRAMA_SEMANTICA_ENABLED=false
TRAMA_SEMANTICA_EXECUTABLE=semantica-mcp
TRAMA_UTOPIA_MCP_URL=
